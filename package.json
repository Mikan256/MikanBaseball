{
  "name": "mikanbaseball",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ブラウザで遊べる野球ゲーム (Vite + three.js)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "release": "npm run build && node scripts/make-release.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "archiver": "^8.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vite": "^8.4.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
